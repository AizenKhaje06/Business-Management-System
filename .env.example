# ----------------------------------------------------------------------------
# Environment Variables — copy this file to .env.local and fill in real values.
# Never commit .env, .env.local, or any file containing real secrets.
# ----------------------------------------------------------------------------

# --- Supabase (public, safe for browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# --- Supabase (server-only — NEVER prefix with NEXT_PUBLIC_) ---
# Used in server components / route handlers / server actions only.
# This key bypasses RLS — never expose it to the browser.
SUPABASE_SECRET_KEY=your-service-role-secret-key
